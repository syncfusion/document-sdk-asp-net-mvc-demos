@section ControlsSection{

    <div class="control-section">
        <style>
            .control-section .checkbox-field {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                line-height: 1;
            }

            .control-section .checkbox-field input[type="checkbox"] {
                margin: 0;
                vertical-align: middle;
                width: 16px;
                height: 16px;
                box-sizing: border-box;
            }

            .control-section .checkbox-field label {
                margin: 0;
            }
        </style>
        @{Html.BeginForm("pagesettings", "pdf", FormMethod.Post);
            {
                <div class="tablediv" style="font-size:14px">
                    Click the button to view a PDF document generated by Essential PDF. Please note
                    that Adobe Reader or its equivalent is required to view the resultant document.
                </div>

                <div>
                    <table width="100%">
                        <tr>
                            <td align="left" width="50%" style="padding:15px 7px 5px 0px">
                                <text>Page Size&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:&nbsp;&nbsp;</text>
                                @{ 
                                    var pageSizeData = ViewData["pagesize"];
                                    IEnumerable<string> pageSizeItems;
                                    var psEnum = pageSizeData as IEnumerable<string>;
                                    var psSelectList = pageSizeData as System.Web.Mvc.SelectList;
                                    if (psEnum != null)
                                    {
                                        pageSizeItems = psEnum;
                                    }
                                    else if (psSelectList != null)
                                    {
                                        pageSizeItems = psSelectList.Cast<System.Web.Mvc.SelectListItem>().Select(i => i.Text);
                                    }
                                    else
                                    {
                                        pageSizeItems = new List<string>();
                                    }
                                }
                                @Html.EJS().DropDownList("pagesize").DataSource(pageSizeItems).PopupHeight("220px").Index(3).Width("175px").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object> { {"id","pagesize"} }).Render()
                            </td>
                        </tr>
                        <tr>
                            <td align="left" width="30%" style="padding:10px 7px 5px 0px">
                                <text>Page Orientation &nbsp;:&nbsp;&nbsp;</text>
                                @{ 
                                    var pageOrientationData = ViewData["pageOrientation"];
                                    IEnumerable<string> pageOrientationItems;
                                    var poEnum = pageOrientationData as IEnumerable<string>;
                                    var poSelectList = pageOrientationData as System.Web.Mvc.SelectList;
                                    if (poEnum != null)
                                    {
                                        pageOrientationItems = poEnum;
                                    }
                                    else if (poSelectList != null)
                                    {
                                        pageOrientationItems = poSelectList.Cast<System.Web.Mvc.SelectListItem>().Select(i => i.Text);
                                    }
                                    else
                                    {
                                        pageOrientationItems = new List<string>();
                                    }
                                }
                                @Html.EJS().DropDownList("pageOrientation").DataSource(pageOrientationItems).PopupHeight("220px").Index(0).Width("175px").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object> { {"id","pageOrientation"} }).Render()
                            </td>
                        </tr>
                        <tr>
                            <td align="left" width="30%" style="padding:10px 7px 5px 0px">
                                <text>Page Margin &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:&nbsp;&nbsp;</text>
                                @{ 
                                    var pageMarginData = ViewData["pageMargin"];
                                    IEnumerable<string> pageMarginItems;
                                    var pmEnum = pageMarginData as IEnumerable<string>;
                                    var pmSelectList = pageMarginData as System.Web.Mvc.SelectList;
                                    if (pmEnum != null)
                                    {
                                        pageMarginItems = pmEnum;
                                    }
                                    else if (pmSelectList != null)
                                    {
                                        pageMarginItems = pmSelectList.Cast<System.Web.Mvc.SelectListItem>().Select(i => i.Text);
                                    }
                                    else
                                    {
                                        pageMarginItems = new List<string>();
                                    }
                                }
                                @Html.EJS().DropDownList("pageMargin").DataSource(pageMarginItems).PopupHeight("220px").Index(0).Width("175px").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object> {  {"id","pageMargin"} }).Render()
                            </td>
                        </tr>
                        <tr>
                            <td align="left" width="30%" style="padding:10px 7px 5px 0px">
                                <text>Page Rotation &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:&nbsp;&nbsp;</text>
                                @{ 
                                    var pageRotationData = ViewData["pageRotation"];
                                    IEnumerable<string> pageRotationItems;
                                    var prEnum = pageRotationData as IEnumerable<string>;
                                    var prSelectList = pageRotationData as System.Web.Mvc.SelectList;
                                    if (prEnum != null)
                                    {
                                        pageRotationItems = prEnum;
                                    }
                                    else if (prSelectList != null)
                                    {
                                        pageRotationItems = prSelectList.Cast<System.Web.Mvc.SelectListItem>().Select(i => i.Text);
                                    }
                                    else
                                    {
                                        pageRotationItems = new List<string>();
                                    }
                                }
                                @Html.EJS().DropDownList("pageRotation").DataSource(pageRotationItems).PopupHeight("220px").Index(0).Width("175px").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object> { {"id","pageRotation"} }).Render()
                            </td>
                        </tr>
                        <tr>
                            <td td align="left" width="30%" style="padding:10px 0px 0px 0px">
                                <text>Pages Count</text> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: &nbsp;
                                <input type="text" readonly id="pageCount" class="e-btn" value="1" style="width: 60px; text-transform:capitalize" />
                                <input type="text" name="pageDetails" id="pageDetails" hidden value="A4,Portrait,No margin,0;" />
                                <input type="text" readonly id="addPage" value="Add Page" class="e-btn" style="width: 120px; text-transform:capitalize" />
                            </td>
                        </tr>
                        <tr>
                            <td align="left" width="30%" style="padding:10px 0px 0px 0px">
                                <span class="checkbox-field">
                                    @Html.EJS().CheckBox("applyTransition").Name("applyTransition").Value("ApplyTransition").Checked(true).Label("Apply Transition").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object> { {"id","applyTransition"} }).Render()
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
                <br />
                <div class="tablediv" style="font-size:14px">
                    <div class="rowdiv">
                        <div class="celldiv">
                            <div>
                                <input type="submit" class="e-btn" value="Generate PDF" style="width: 150px; text-transform:capitalize" />
                            </div>
                        </div>
                    </div>
                </div>
                Html.EndForm();
            }
        }
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var addButton = document.getElementById('addPage');
            addButton.addEventListener('click', function (event) {
                var pageCount = document.getElementById('pageCount');
                pageCount.value = parseInt(pageCount.value) + 1;

                var ps = document.getElementById('pagesize').value;
                var po = document.getElementById('pageOrientation').value;
                var pm = document.getElementById('pageMargin').value;
                var pr = document.getElementById('pageRotation').value;
                var pageDetails = document.getElementById('pageDetails');
                pageDetails.value = pageDetails.value + ps + ',' + po + ',' + pm + ',' + pr + ';';
            });
        });
    </script>
}
@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
        This sample demonstrates adding pages with different settings such as rotation, orientation, page size, and transition.
    </div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the Page Settings in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
    <div id="description" style="margin-top: 10px">
        It is also possible to add or insert pages and sections, remove pages, rearrange pages and more.
        More information about the pages and sections can be found in this documentation<a href="https://help.syncfusion.com/file-formats/pdf/working-with-pages"> section.</a>
    </div>
}

@section Title{
                    <title>ASP.NET MVC PDF library - Page Settings Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Page Settings in ASP.NET MVC PDF Library</h1>
                }