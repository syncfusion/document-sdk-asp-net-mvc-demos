@section ControlsSection{


    <div class="control-section">
        @{Html.BeginForm("pdfcompression", "pdf", FormMethod.Post);
            {

               <div class="rowdiv" style="font-size:14px">
                    <div class="celldiv">
                        <table width="100%">
                            <tr>
                                <td>
                                    Click the button to view an PDF document generated by Essential PDF. Please note
                                    that Adobe Reader or its equivalent is required to view the resultant document.
                                </td>
                            </tr>
                            <tr>
                                <td align="left" width="100%">
                                    <br />
                                    @{
                                        /* -------- Compress Binding -------- */
                                        var compressData = ViewData["compress"];
                                        IEnumerable<string> compressItems;

                                        var enumData1 = compressData as IEnumerable<string>;
                                        var selectListData1 = compressData as System.Web.Mvc.SelectList;

                                        if (enumData1 != null)
                                        {
                                            compressItems = enumData1;
                                        }
                                        else if (selectListData1 != null)
                                        {
                                            compressItems = selectListData1
                                                .Cast<System.Web.Mvc.SelectListItem>()
                                                .Select(i => i.Text);
                                        }
                                        else
                                        {
                                            compressItems = new List<string>();
                                        }

                                        /* -------- Image Binding -------- */
                                        var imgData = ViewData["img"];
                                        IEnumerable<string> imgItems;

                                        var enumData2 = imgData as IEnumerable<string>;
                                        var selectListData2 = imgData as System.Web.Mvc.SelectList;

                                        if (enumData2 != null)
                                        {
                                            imgItems = enumData2;
                                        }
                                        else if (selectListData2 != null)
                                        {
                                            imgItems = selectListData2
                                                .Cast<System.Web.Mvc.SelectListItem>()
                                                .Select(i => i.Text);
                                        }
                                        else
                                        {
                                            imgItems = new List<string>();
                                        }
                                    }

                                    <!-- Row 1 -->
                                    <div style="display: inline-block; width: 220px;">
                                        Choose the compression level
                                    </div>

                                    <div style="display: inline-block;">
                                        @Html.EJS().DropDownList("compress").DataSource(compressItems).PopupHeight("220px").Index(0).Width("175px").HtmlAttributes(new Dictionary<string, object>{ { "id", "compress" } }).Render()
                                    </div>

                                    <br /><br />

                                    <!-- Row 2 -->
                                    <div style="display: inline-block; width: 220px;">
                                        Image Compression
                                    </div>

                                    <div style="display: inline-block;">
                                        @Html.EJS().DropDownList("img").DataSource(imgItems).PopupHeight("220px").Index(0).Width("175px").HtmlAttributes(new Dictionary<string, object>{ { "id", "img" } }).Render()
                                    </div>

                                </td>
                            </tr>
                        </table>
                        </div>
                </div>
                <div class="celldiv" style="font-size:14px">
                        <table width="100%">
                            <tr>
                                <td align="left">
                                    <br />
                                    <input id="submit" type="submit" class="e-btn" value="Generate PDF" style="width:150px; text-transform:capitalize" />
                                </td>
                            </tr>
                        </table>
                </div>
                Html.EndForm();
            }}
</div>
}
@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
        This sample demonstrates the creation of compressed PDF document. It compresses the content stream and images in the PDF document based on the quality factor.
    </div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the PDF Compression Level in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
    <div id="description" style="margin-top: 10px">
        It is also possible to  <a href="https://help.syncfusion.com/file-formats/pdf/working-with-compression#compressing-existing-pdf-document">compress the existing PDF document</a> by removing the metadata, optimizing the font, and page content.
    </div>
}
@section Title{
                    <title>ASP.NET MVC PDF library - PDF Compression Level Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of PDF Compression Level in ASP.NET MVC PDF Library</h1>
                }