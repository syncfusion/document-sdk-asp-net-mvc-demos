@section ControlsSection{



<div class="control-section">
    <style>
        .control-section .checkbox-field {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            line-height: 1;
        }

        .control-section .checkbox-field input[type="checkbox"] {
            margin: 0;
            vertical-align: middle;
            width: 16px;
            height: 16px;
            box-sizing: border-box;
        }

        .control-section .checkbox-field label {
            margin: 0;
        }
    </style>
    @{Html.BeginForm("compressexistingpdf", "pdf", FormMethod.Post, new { enctype = "multipart/form-data", id = "compressPDF", @onsubmit = "return appendHashToAction(this);" });
    }
      <div style="font-size:14px">
          <table>
              <tr>
                  <td>
                      Click the button to view the PDF document generated by Essential PDF. Please note
                      that Adobe Reader or its equivalent is required to view the resultant document.
                  </td>
              </tr>
          </table>
      </div>
            <div class="rowdiv" style="font-size:14px">
                <div class="celldiv">
                    <br />
                    <p>Choose a PDF file to compress</p>
                    <div>
                        <table width="100%">
                            <tr>
                                <td>
                                    <div>
                                        <input type="button" class="e-btn" value="Choose File" onclick="openPageCompress()">
                                        <span id="fileNameBoxCompress"> No file chosen </span>
                                        <input type="file" name="file" id="fileUploadCompress" accept="application/pdf" style="display:block;visibility:hidden;width:0;height:0;" />
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div id="errorlabel" value="error">
                        <p style="color: #FF0000;">
                            @Html.Label("", (string)ViewData["lab"])
                    </div>
                    <div class="alert alert-info" id="compressStatus" style="display:none">
                        The file compressed successfully.
                    </div>
                    <br />
                    <p>Compression Options</p>

                    <div>
                        <table style="width:auto;">

                            <!-- Row 1 -->
                            <tr>
                                <td style="padding:6px 25px 6px 0px; vertical-align:middle;">
                                    <span style="display:inline-flex; align-items:center;">
                                        @Html.EJS().CheckBox("CompressImage").Name("CompressImage").Value("true").Checked(true).Label("Compress Image").HtmlAttributes(new Dictionary<string, object> { { "id", "CompressImage" }, { "onchange", "isCompressImageOnChanged(this)" } }).Render()
                                    </span>
                                </td>

                                <td style="padding:6px 7px; vertical-align:middle;">
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <span style="min-width:110px; font-weight:400;">Image Quality</span>

                                        @{
                                            var imageQualityData = ViewData["imageQuality"];
                                            IEnumerable<string> imageQualityItems;
                                            var enumData = imageQualityData as IEnumerable<string>;
                                            var selectListData = imageQualityData as System.Web.Mvc.SelectList;

                                            if (enumData != null) { imageQualityItems = enumData; }
                                            else if (selectListData != null) { imageQualityItems = selectListData.Cast<System.Web.Mvc.SelectListItem>().Select(i => i.Text); }
                                            else { imageQualityItems = new List<string>(); }
                                        }

                                        @Html.EJS().DropDownList("imageQuality").DataSource(imageQualityItems).PopupHeight("220px").Index(4).Width("90px").HtmlAttributes(new Dictionary<string, object> { { "id", "imageQuality" } }).Render()
                                    </div>
                                </td>
                            </tr>

                            <!-- Row 2 -->
                            <tr>
                                <td style="padding:6px 25px 6px 0px; vertical-align:middle;">
                                    <span style="display:inline-flex; align-items:center;">
                                        @Html.EJS().CheckBox("optPageContents").Name("optPageContents").Value("true").Checked(true).Label("Optimize Page Contents").HtmlAttributes(new Dictionary<string, object> { { "id", "optPageContents" } }).Render()
                                    </span>
                                </td>

                                <td style="padding:6px 7px; vertical-align:middle;">
                                    <span style="display:inline-flex; align-items:center;">
                                        @Html.EJS().CheckBox("removeMetaData").Name("removeMetaData").Value("true").Checked(true).Label("Remove Metadata Information").HtmlAttributes(new Dictionary<string, object> { { "id", "removeMetaData" } }).Render()
                                    </span>
                                </td>
                            </tr>

                            <!-- Row 3 -->
                            <tr>
                                <td style="padding:6px 25px 6px 0px; vertical-align:middle;">
                                    <span style="display:inline-flex; align-items:center;">
                                        @Html.EJS().CheckBox("optFont").Name("optFont").Value("true").Checked(true).Label("Optimize Font").HtmlAttributes(new Dictionary<string, object> { { "id", "optFont" } }).Render()
                                    </span>
                                </td>
                            </tr>

                        </table>
                    </div>

                </div>
            </div>
            <br />
            <div class="celldiv" style="font-size:14px">
                    <table width="100%">
                       <tr>
                            <td align="left">
                               <input id="submit" class="e-btn" type="submit" value="Compress PDF" style="width:150px; text-transform:capitalize"/>
                            </td>
                        </tr>
                    </table>
                </div>
    </div>
    }
<script type="text/javascript">
    function isCompressImageOnChanged(element) {
        element.checked ? document.getElementById("imageQuality").disabled = false : document.getElementById("imageQuality").disabled = true;
    }
</script>
<script type="text/javascript">
   (function worker() {
       var ajax = new ej.base.Ajax({
            url: '@Url.Action("GetStatus", "Pdf")',
            success: function (data) {

                if (data != "") {
                    document.getElementById("compressStatus").innerHTML = data;
                    document.getElementById('compressStatus').removeAttribute("style");

                }


            },
            complete: function () {
                setTimeout(worker, 300);
            }
        });
    })();
</script>
<script>
    function openPageCompress() {
        document.getElementById('fileUploadCompress').click();
        document.getElementById('fileUploadCompress').addEventListener('change', readFileCompress, false);
    }
    function readFileCompress(evt) {
        var upoadedFiles = evt.target.files;
        if (upoadedFiles && upoadedFiles.length > 0) {
            var filename = upoadedFiles[0].name;
            document.getElementById('fileNameBoxCompress').textContent = filename;
        }
    }
</script>
@section ActionDescription{
<div id="action-description" style="margin-top: 10px">
    This sample demonstrates the optimization of an existing PDF document based on image quality, page content, metadata, and font to reduce the file size of the PDF document.
</div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the Compress Existing PDF in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
<div id="description" style="margin-top: 10px">
    This feature can be used to reduce response times in web based applications, mails and more.
    More information about compression can be found in this documentation <a href="https://help.syncfusion.com/file-formats/pdf/working-with-compression#compressing-existing-pdf-document">section.</a>
</div>
}
@section Title{
                    <title>ASP.NET MVC PDF library - Compress Existing PDF Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Compress Existing PDF in ASP.NET MVC PDF Library</h1>
                }
<script>
    function appendHashToAction(form) {
        try {
            if (window && window.location && window.location.hash) {
                // Ensure we don't duplicate the hash
                var hash = window.location.hash;
                if (form.action.indexOf(hash) === -1) {
                    form.action = form.action + hash;
                }
            }
        }
        catch (e) {
            // swallow any errors to avoid blocking form submit
        }
        return true;
    }
</script>