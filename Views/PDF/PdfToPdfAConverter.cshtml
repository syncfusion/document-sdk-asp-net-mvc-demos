@section ControlsSection{

<div class="control-section">
    @{Html.BeginForm("pdftopdfaconverter", "pdf", FormMethod.Post, new { enctype = "multipart/form-data", id = "pdftopdfa", @onsubmit = "return appendHashToAction(this);" });
        {
            <div style="font-size:14px">
                <table>
                    <tr>
                        <td>
                            Click the button to view an PDF document generated by Essential PDF. Please note
                            that Adobe Reader or its equivalent is required to view the resultant document.
                        </td>
                    </tr>
                </table>
            </div>
            <div class="tablediv" style="font-size:14px">
                <div class="rowdiv">
                    <div class="celldiv">
                        <br />
                        <text>Choose a PDF file to convert</text>
                        <table width="100%">
                            <tr>
                                <td>
                                    <br />
                                    <div>
                                        <input type="button" class="e-btn" value="Choose File" onclick="openPdfToPdfAPicker()" />
                                        <span id="fileNameBoxPdfA"> No file chosen </span>
                                        <input type="file" name="file" id="fileUploadPdfA" accept="application/pdf" style="display:block;visibility:hidden;width:0;height:0;" />
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td align="left" width="50%" style="padding:15px 7px 5px 0px">
                                    <text>Please select the conformance&nbsp;&nbsp;:&nbsp;&nbsp;</text>
                                    @{
                                        var priorityData = ViewData["conformance"];
                                        IEnumerable<string> priorityItems;

                                        var enumData = priorityData as IEnumerable<string>;
                                        var selectListData = priorityData as System.Web.Mvc.SelectList;

                                        if (enumData != null)
                                        {
                                            priorityItems = enumData;
                                        }
                                        else if (selectListData != null)
                                        {
                                            priorityItems = selectListData
                                                            .Cast<System.Web.Mvc.SelectListItem>()
                                                            .Select(i => i.Text);
                                        }
                                        else
                                        {
                                            priorityItems = new List<string>();
                                        }
                                    }

                                    @Html.EJS().DropDownList("conformance").DataSource(priorityItems).PopupHeight("220px").Index(0).Width("135px").HtmlAttributes(new Dictionary<string, object>{ { "id", "conformance" } }).Render()
                                </td>
                            </tr>
                            </table>
                            <div id="errorlabel" value="error">
                                <br />
                                <p style="color: #FF0000;">
                                    @Html.Label("", (string)ViewData["lab"])
                            </div>
                            <table width="100%">
                                <tr>
                                    <td align="left">
                                        <input id="submit" type="submit" class="e-btn" value="Convert to PDF/A" style="width:170px; text-transform:capitalize" />
                                    </td>
                                </tr>
                            </table>
                    </div>
                </div>
            </div>
            Html.EndForm();
        }}
</div>
}

@section Scripts {
    <script>
        (function () {
            var fileInput = document.getElementById('fileUploadPdfA');
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    if (this.files && this.files.length > 0) {
                        document.getElementById('fileNameBoxPdfA').textContent = this.files[0].name;
                    } else {
                        document.getElementById('fileNameBoxPdfA').textContent = ' No file chosen ';
                    }
                }, false);
            }
        })();

        function openPdfToPdfAPicker() {
            document.getElementById('fileUploadPdfA').click();
        }
    </script>
}

@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
        This sample demonstrates the conversion of PDF to PDF/A-1b standard document using Essential PDF.
    </div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the PDF to PDF-A in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
    <div id="description" style="margin-top: 10px">
        This feature can be used for long term archiving and standardization.
        More information about conformance can be found in this documentation <a href="https://help.syncfusion.com/file-formats/pdf/working-with-pdf-conformance">section.</a>
    </div>
}


@section Title{
                    <title>ASP.NET MVC PDF library - PDF to PDF-A Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of PDF to PDF-A in ASP.NET MVC PDF Library</h1>
                }
<script>
    function appendHashToAction(form) {
        try {
            if (window && window.location && window.location.hash) {
                // Ensure we don't duplicate the hash
                var hash = window.location.hash;
                if (form.action.indexOf(hash) === -1) {
                    form.action = form.action + hash;
                }
            }
        }
        catch (e) {
            // swallow any errors to avoid blocking form submit
        }
        return true;
    }
</script>