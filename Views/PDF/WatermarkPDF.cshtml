@section ControlsSection {
    <div class="control-section">
        <style>
            .control-section .checkbox-field {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                line-height: 1;
            }

                .control-section .checkbox-field input[type="checkbox"] {
                    margin: 0;
                    vertical-align: middle;
                    width: 16px;
                    height: 16px;
                    box-sizing: border-box;
                }

                .control-section .checkbox-field label {
                    margin: 0;
                }
        </style>
        @{
            Html.BeginForm("watermarkpdf", "pdf", FormMethod.Post, new { enctype = "multipart/form-data", id = "watermarkPDF", @onsubmit = "return appendHashToAction(this);" });
            {
                <div class="tablediv" style="font-size:14px">
                    Click the button to view a PDF document generated by Essential PDF. Please note
                    that Adobe Reader or its equivalent is required to view the resultant document.
                </div>
                <div id="errorlabel" value="error">
                    <p style="color: #FF0000;">
                        @Html.Label("", (string)ViewData["lab"])
                    </p>
                </div>
                <div style="font-size:14px">
                    <br />

                    <input type="button" class="e-btn" value="Choose File" onclick="openPage()">
                    <span id="fileNameBox"> HTTP Succinctly.pdf </span>
                    <input type="file" name="file" id="fileUpload" accept="application/pdf" style="display:block;visibility:hidden;width:0;height:0;" />
                </div>
                <br />
                <div style="padding-top:7px; font-size:14px">
                    <text>Stamping Text:&nbsp;</text>
                    <input type="text" style="width:320px; margin-left: 12px" id="Stamptext" class="e-input" value="Created using Syncfusion PDF library"
                           name="Stamptext">
                </div>
                <br />
                <div style="padding-top:7px; font-size:14px">
                    <text>Set Transparency:&nbsp;</text>
                    @{
                        var transparencyItems = new System.Collections.Generic.List<System.Web.Mvc.SelectListItem>() {
                            new System.Web.Mvc.SelectListItem { Text = "25", Value = "0.25", Selected = true },
                            new System.Web.Mvc.SelectListItem { Text = "50", Value = "0.50" },
                            new System.Web.Mvc.SelectListItem { Text = "75", Value = "0.75" },
                            new System.Web.Mvc.SelectListItem { Text = "100", Value = "1.00" }
                        };
                    }
                    @Html.EJS().DropDownList("transparency").DataSource(transparencyItems).Fields(new Syncfusion.EJ2.DropDowns.DropDownListFieldSettings { Text = "Text", Value = "Value" }).PopupHeight("220px").Index(0).Width("90px").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object> { { "id", "transparency" } }).Render()
                </div>
                <br />
                <tr>
                    <td>
                        <span class="checkbox-field">
                            @Html.EJS().CheckBox("imageWatermark").Name("imageWatermark").Value("Watermark").Checked(false).Label("Image Watermark").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object> { { "id", "imageWatermark" }, { "onchange", "toggleImageUpload.call(this)" } }).Render()
                        </span>
                    </td>
                </tr>
                <br />
                <div style="font-size:14px">
                    <br />
                    <input type="button" id="chooseImageBtn" class="e-btn" value="Choose Image" onclick="openPageImage()" style="display:none;">
                    <span id="fileNameBoxImage" style="display:none;"> No file chosen </span>
                    <input type="file" id="imageFile" name="imageFile" style="margin-left:17px; display:none; visibility:hidden; width:0; height:0;" accept="image/jpeg, image/png, image/gif, image/bmp" />
                </div>
                <br />
                <div class="tablediv" style="font-size:14px">
                    <div class="rowdiv">
                        <div class="celldiv">
                            <div>
                                <input type="submit" class="e-btn" value="Watermark PDF" style="width: 150px; text-transform:capitalize" />
                            </div>
                        </div>
                    </div>
                </div>
                Html.EndForm();
            }
        }
    </div>
}
<script>
    function openPage() {
        document.getElementById('fileUpload').click();
        document.getElementById('fileUpload').addEventListener('change', readFile, false);
    }
    function readFile(evt) {
        var upoadedFiles = evt.target.files;
        if (upoadedFiles && upoadedFiles.length > 0) {
            var filename = upoadedFiles[0].name;
            var el = document.getElementById('fileNameBox');
            if (el) el.textContent = filename;
        }
    }
</script>
<script>
    function toggleImageUpload() {
        var imageCheckbox = document.getElementById("imageWatermark");
        var imageFileInput = document.getElementById("imageFile");
        var chooseBtn = document.getElementById('chooseImageBtn');
        var nameBox = document.getElementById('fileNameBoxImage');
        if (imageCheckbox && imageCheckbox.checked) {
            if (imageFileInput) imageFileInput.style.display = 'inline-block';
            if (chooseBtn) chooseBtn.style.display = 'inline-block';
            if (nameBox) nameBox.style.display = 'inline';
        } else {
            if (imageFileInput) { imageFileInput.style.display = 'none'; imageFileInput.value = null; }
            if (chooseBtn) chooseBtn.style.display = 'none';
            if (nameBox) { nameBox.style.display = 'none'; nameBox.textContent = ' No file chosen'; }
        }
    }
    function openPageImage() {
        var fileEl = document.getElementById('imageFile');
        if (fileEl) {
            fileEl.click();
            fileEl.addEventListener('change', readFileImage, false);
        }
    }
    function readFileImage(evt) {
        var upoadedFiles = evt.target.files;
        if (upoadedFiles && upoadedFiles.length > 0) {
            var el = document.getElementById('fileNameBoxImage');
            if (el) el.textContent = upoadedFiles[0].name;
        }
    }
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var chk = document.getElementById('imageWatermark');
        var chooseBtn = document.getElementById('chooseImageBtn');
        var nameBox = document.getElementById('fileNameBoxImage');
        var fileEl = document.getElementById('imageFile');
        function updateVisibility() {
            var checked = !!(chk && (chk.checked || (chk.ej2_instances && chk.ej2_instances[0] && chk.ej2_instances[0].checked)));
            if (checked) {
                if (chooseBtn) chooseBtn.style.display = 'inline-block';
                if (nameBox) nameBox.style.display = 'inline';
                if (fileEl) fileEl.style.display = 'inline-block';
            } else {
                if (chooseBtn) chooseBtn.style.display = 'none';
                if (nameBox) { nameBox.style.display = 'none'; nameBox.textContent = ' No file chosen'; }
                if (fileEl) { fileEl.style.display = 'none'; fileEl.value = null; }
            }
        }
        updateVisibility();
        if (chk) {
            try { chk.addEventListener('change', updateVisibility); } catch (e) { }
            // Also attempt to bind to EJ2 change if present
            if (chk.ej2_instances && chk.ej2_instances[0]) {
                var inst = chk.ej2_instances[0];
                if (inst && inst.addEventListener) inst.addEventListener('change', updateVisibility);
            }
        }
    });
</script>
}

@section ActionDescription{
    <p>
        This sample demonstrates how to stamp an existing PDF document using text. The Essential PDF supports both stamp and watermark with text and images in the PDF document.
    </p>
}
@section Meta{
    <meta name="description" content="This example demonstrates the Import and Stamp in ASP.NET MVC PDF library. Explore here for more details." />
}
@section Description{
    <p>
        This feature can be used to stamp the PDF document for draft, confidential, review purpose only, company logo, copyright notice and more.
        More information about the stamp or watermark can be found in this documentation <a href="https://help.syncfusion.com/file-formats/pdf/working-with-watermarks">section.</a>
    </p>
}
@section Title{
    <title>ASP.NET MVC PDF library - Import and Stamp Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of Import and Stamp in ASP.NET MVC PDF Library</h1>
}
<script>
    function appendHashToAction(form) {
        try {
            if (window && window.location && window.location.hash) {
                // Ensure we don't duplicate the hash
                var hash = window.location.hash;
                if (form.action.indexOf(hash) === -1) {
                    form.action = form.action + hash;
                }
            }
        }
        catch (e) {
            // swallow any errors to avoid blocking form submit
        }
        return true;
    }
</script>
