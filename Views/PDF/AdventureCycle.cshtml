@section ControlsSection{

<div class="control-section">
    <style>
        /* Robust alignment for native checkbox + label */
        .control-section .checkbox-field {
            display: inline-flex;
            align-items: center; /* vertically center checkbox and label */
            gap: 8px; /* consistent spacing between checkbox and label */
            line-height: 1; /* avoid text baseline drift */
        }

        .control-section .checkbox-field input[type="checkbox"] {
            margin: 0; /* remove default offset */
            vertical-align: middle; /* fallback for older UAs */
            width: 16px;
            height: 16px;
            box-sizing: border-box;
        }

        .control-section .checkbox-field label {
            margin: 0; /* spacing handled by gap */
        }
    </style>
    @{Html.BeginForm("adventurecycle", "pdf", FormMethod.Post);
        {
           <div class="tablediv" style="font-size:14px">
                <div class="rowdiv">
                    <div class="celldiv">
                        <div>
                            <table width="100%">
                                <tr>
                                    <td>
                                        Click the button to view an PDF document generated by Essential PDF. Please note
                                        that Adobe Reader or its equivalent is required to view the resultant document.
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left">
                                        <br />
                                        <text> Choose built-in styles</text>   &emsp;
                                        @Html.DropDownList("styleName", null, "GridTable4", new {@class="e-btn"})
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div>
                                            <table width="100%">
                                                <tr>
                                                    <td>
                                                        <br />
                                                        <p for="Opentype">
                                                            Built-in style settings
                                                        </p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left">
                                                        <span class="checkbox-field">
                                                            <input type="checkbox" id="header" name="Header" value="header" checked="checked" />
                                                            <label for="header">Header row</label>
                                                        </span>
                                                    </td>
                                                    <td align="left">
                                                        <span class="checkbox-field">
                                                            <input type="checkbox" id="bandedrow" name="Bandedrow" value="bandedrow" checked="checked" />
                                                            <label for="bandedrow">Banded row</label>
                                                        </span>
                                                    </td>
                                                    <td align="left">
                                                        <span class="checkbox-field">
                                                            <input type="checkbox" id="firstcolumn" name="Firstcolumn" value="firstcolumn" />
                                                            <label for="firstcolumn">First column</label>
                                                        </span>
                                                    </td>


                                                </tr>
                                                <tr>
                                                    <td align="left">
                                                        <span class="checkbox-field">
                                                            <input type="checkbox" id="lastrow" name="Lastrow" value="lastrow" />
                                                            <label for="lastrow">Last row</label>
                                                        </span>
                                                    </td>

                                                    <td align="left">
                                                        <span class="checkbox-field">
                                                            <input type="checkbox" id="bandedcolumn" name="Bandedcolumn" value="bandedcolumn" />
                                                            <label for="bandedcolumn">Banded column</label>
                                                        </span>
                                                    </td>
                                                    <td align="left">
                                                        <span class="checkbox-field">
                                                            <input type="checkbox" id="lastcolumn" name="Lastcolumn" value="lastcolumn" />
                                                            <label for="lastcolumn">Last column</label>
                                                        </span>
                                                    </td>

                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <table>
                               <tr>
                                    <td align="left">
                                        <br />
                                        <input type="submit" class="e-btn" value="Generate PDF" style="width: 150px; text-transform:capitalize" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
            <br />            
            Html.EndForm();
        }}
</div>
}
@section ActionDescription{
<div id="action-description" style="margin-top: 10px">
    This sample demonstrates creation of simple table report in the PDF document using <a href="https://help.syncfusion.com/file-formats/pdf/working-with-tables#creating-a-simple-table-using-pdfgrid-in-a-new-document">PDF Grid. When <span class="sr-only">opens in a new tab</span></a>built-in <a href="https://help.syncfusion.com/file-formats/pdf/working-with-tables#built-in-table-styles">table styles<span class="sr-only">opens in a new tab</span></a> are applied to the grid, it will appear like Microsoft Office table style and more styling options are available.
</div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the Adventure Cycle Works in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
    <div id="description" style="margin-top: 10px">
        More information about the tables can be found in this documentation<a href="https://help.syncfusion.com/file-formats/pdf/working-with-tables"> section.<span class="sr-only">opens in a new tab</span></a>
    </div>
}




@section Title{
                    <title>ASP.NET MVC PDF library - Adventure Cycle Works Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Adventure Cycle Works in ASP.NET MVC PDF Library</h1>
                }