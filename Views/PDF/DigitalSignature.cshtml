@section ControlsSection{

    <div class="control-section">
    <style>
        .control-section .radio-row {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .control-section .radio-group {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        
        .control-section .radio-field {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .control-section .radio-field input[type="radio"] {
            margin: 0;
            position: relative;
            top: 0;          /* key line */
        }
        
        .control-section .radio-field label {
            margin: 0;
            line-height: 1;  /* key line */
        }
        .control-section .radio-spacing {
            padding-top: 10px;
        }
        .control-section #signatureTypeLabel { padding-bottom: 3px; }
    </style>
        @{Html.BeginForm("digitalsignature", "pdf", FormMethod.Post, new { enctype = "multipart/form-data", id = "digitalSign", @onsubmit = "return appendHashToAction(this);" });
            {
        <div style="font-size:14px">
            <table>
                <tr>
                    <td>
                        Click the button to view the PDF document generated by Essential PDF. Please note
                        that Adobe Reader or its equivalent is required to view the resultant document.
                    </td>
                </tr>
            </table>
        </div>
               <div id="errorlabel" value="error">
                    <p style="color: #FF0000;">
                        @Html.Label("", (string)ViewData["lab"])
                </div>
               <div class="tablediv" style="font-size:14px">
                   <div class="rowdiv">
                       <div class="celldiv">
                           <table width="100%">
                               <tbody>
                                   <tr>
                                       <td align="left">
                                           <span id="label8">Signature Settings</span>
                                           <div style="border: solid 1px #788DB3; line-height: 23px; padding: 10px; ">
                                               <table cellspacing="0" cellpadding="0" border="0">
                                                   <tbody>
                                                       <tr>
                                                           <td valign="middle" style="padding-left: 0px; width: 100%;">                                                            
                                                               <div class="radio-row">
                                                                   <span id="label4">Cryptographic Standard:</span>
                                                                   <div class="radio-group">
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("Cryptographic").Name("Cryptographic").Value("CMS").Checked(true).Label("CMS").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList1_0"}}).Render()
                                                                       </span>
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("Cryptographic").Name("Cryptographic").Value("CAdES").Checked(false).Label("CAdES").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList1_1"}}).Render()
                                                                       </span>
                                                                   </div>
                                                               </div>
                                                           </td>

                                                       </tr>
                                                       <tr>
                                                           <td class="radio-spacing" valign="middle" style="padding-left: 0px; width: 100%;">
                                                               <br />
                                                               <div class="radio-row">
                                                                   <span id="label4">Digest Algorithm:</span>
                                                                   <div class="radio-group">
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("digestAlgorithm").Name("digestAlgorithm").Value("SHA1").Checked(false).Label("SHA1").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList3_0"}}).Render()
                                                                       </span>
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("digestAlgorithm").Name("digestAlgorithm").Value("SHA256").Checked(true).Label("SHA256").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList3_1"}}).Render()
                                                                       </span>
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("digestAlgorithm").Name("digestAlgorithm").Value("SHA384").Checked(false).Label("SHA384").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList3_2"}}).Render()
                                                                       </span>
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("digestAlgorithm").Name("digestAlgorithm").Value("SHA512").Checked(false).Label("SHA512").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList3_3"}}).Render()
                                                                       </span>
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("digestAlgorithm").Name("digestAlgorithm").Value("RIPEMD160").Checked(false).Label("RIPEMD160").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList3_4"}}).Render()
                                                                       </span>
                                                                   </div>
                                                               </div>
                                                           </td>

                                                       </tr>
                                                   </tbody>
                                               </table>
                                           </div>
                                       </td>
                                   </tr>
                               </tbody>
                           </table>

                       </div>
                   </div>
                   <br />
                   <div class="rowdiv">
                       <div class="celldiv">
                           <table width="100%">
                               <tbody>
                                   <tr>
                                       <td align="left">
                                           <span id="label8">Sign new PDF document</span>
                                           <div style="border: solid 1px #788DB3; line-height: 23px; padding: 10px; ">
                                               <table cellspacing="0" cellpadding="0" border="0">
                                                   <tbody>
                                                       <tr>
                                                           <td class="radio-spacing" valign="middle" style="padding-left: 0px; width: 100%;">
                                                               <div class="radio-row">
                                                                   <span id="signatureTypeLabel">Signature Type:</span>
                                                                   <div class="radio-group">
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("RadioButtonList2").Name("RadioButtonList2").Value("Standard").Checked(true).Label("Standard").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList2_0"}}).Render()
                                                                       </span>
                                                                       <span class="radio-field">
                                                                           @Html.EJS().RadioButton("RadioButtonList2").Name("RadioButtonList2").Value("Author").Checked(false).Label("Author").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","RadioButtonList2_1"}}).Render()
                                                                       </span>
                                                                   </div>
                                                               </div>
                                                           </td>

                                                       </tr>
                                                       <tr>
                                                           <td align="left">
                                                               <br />
                                                               <input name="submit" class="e-btn" id="submit" type="submit" value="Create PDF" style="width: 190px;" />
                                                           </td>
                                                       </tr>
                                                   </tbody>
                                               </table>
                                           </div>
                                       </td>
                                   </tr>
                               </tbody>
                           </table>

                       </div>
                   </div>
                   <br />
                   <div class="rowdiv">
                       <div class="celldiv">
                           <table width="100%">
                               <tbody>
                                   <tr>
                                       <td align="left">
                                           <span id="label8">Sign existing PDF document</span><br>
                                           <div style="border: solid 1px #788DB3; line-height: 23px; padding: 10px;">
                                               <table cellspacing="0" cellpadding="0" border="0">
                                                   <tbody>
                                                       <tr>
                                                           <td align="left" width="100%">
                                                               <div>
                                                                   <text for="page index">Source</text><br />
                                                                   <input type="button" class="e-btn" value="Choose File" onclick="openPdfDocumentPicker()">
                                                                   <span id="fileNameBoxPdf"> No file chosen </span>
                                                                   <input type="file" id="fileUploadPdfDocument" name="pdfdocument" accept="application/pdf" style="display:block;visibility:hidden;width:0;height:0;" />
                                                               </div>
                                                           </td>
                                                       </tr>
                                                       <tr>

                                                           <td align="left">
                                                               <br />
                                                               <text>Certificate</text><br />
                                                               <input type="button" class="e-btn" value="Choose File" onclick="openCertificatePicker()">
                                                               <span id="fileNameBoxCert"> No file chosen </span>
                                                               <input type="file" id="fileUploadCertificate" name="certificate" accept=".pfx, application/pfx" style="display:block;visibility:hidden;width:0;height:0;" />

                                                           </td>
                                                       </tr>
                                                       <tr>
                                                           <td align="left" width="100%">
                                                               <br />
                                                               <div>
                                                                   <text>Password</text>
                                                                   <label>
                                                                       <input type="password" class="e-input" style="width: 102%; margin-left: 105px" id="password" value="" textmode="Password"
                                                                              name="password">
                                                                   </label>
                                                               </div>
                                                           </td>
                                                       </tr>
                                                       <tr>
                                                           <td>
                                                               <div style="line-height: 23px;">
                                                                   <span id="label1">Reason</span>
                                                                   <label>
                                                                       <input type="text" class="e-input" style="width: 98%; margin-left: 117px" id="Reason" value=""
                                                                              name="Reason">
                                                                   </label>
                                                               </div>

                                                           </td>
                                                       </tr>
                                                       <tr>
                                                           <td align="left">
                                                               <div style="line-height: 23px;">
                                                                   <span id="label1">Contact</span>
                                                                   <label>
                                                                       <input type="text" class="e-input" style="width: 98%; margin-left: 116px" id="Contact" value=""
                                                                              name="Contact">
                                                                   </label>
                                                               </div>
                                                           </td>
                                                       </tr>

                                                       <tr>
                                                           <td align="left">
                                                               <div style="line-height: 23px;">
                                                                   <span id="label1">Location</span>
                                                                   <label>
                                                                       <input type="text" class="e-input" style="width: 100%; margin-left: 111px" id="Location" value=""
                                                                              name="Location">
                                                                   </label>
                                                               </div>
                                                           </td>
                                                       </tr>
                                                       <tr>
                                                           <td align="left">
                                                               <input name="submit" class="e-btn" type="submit" id="submit" value="Create Sign PDF" style="width: 150px; text-transform:capitalize" />
                                                           </td>
                                                       </tr>

                                                   </tbody>
                                               </table>
                                           </div>
                                       </td>
                                   </tr>
                               </tbody>
                           </table>
                       </div>
                   </div>
               </div>
               
                   Html.EndForm();
                }}
    </div>
    }

    @section Scripts {
        <script>
            (function () {
                var pdfInput = document.getElementById('fileUploadPdfDocument');
                if (pdfInput) {
                    pdfInput.addEventListener('change', function () {
                        if (this.files && this.files.length > 0) {
                            document.getElementById('fileNameBoxPdf').textContent = this.files[0].name;
                        } else {
                            document.getElementById('fileNameBoxPdf').textContent = ' No file chosen ';
                        }
                    }, false);
                }

                var certInput = document.getElementById('fileUploadCertificate');
                if (certInput) {
                    certInput.addEventListener('change', function () {
                        if (this.files && this.files.length > 0) {
                            document.getElementById('fileNameBoxCert').textContent = this.files[0].name;
                        } else {
                            document.getElementById('fileNameBoxCert').textContent = ' No file chosen ';
                        }
                    }, false);
                }
            })();

            function openPdfDocumentPicker() {
                document.getElementById('fileUploadPdfDocument').click();
            }

            function openCertificatePicker() {
                document.getElementById('fileUploadCertificate').click();
            }
        </script>
    }
@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
       This sample demonstrates how a PDF document can be secured with certificates and signed with either standard or author signatures. Now added the support for Elliptic Curve Digital Signature Algorithm (ECDSA) to sign the PDF document.
    </div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the Digital Signature in ASP.NET MVC PDF library. Explore here for more details."/>
                }
