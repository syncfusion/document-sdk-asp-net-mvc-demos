    <div id="description" style="margin-top: 10px">
        It is also possible to digitally sign with <a href="https://help.syncfusion.com/file-formats/pdf/working-with-digitalsignature#adding-a-timestamp-in-digital-signature">timestamp.</a>
        More information about the digital signature and timestamp can be found in this documentation <a href="https://help.syncfusion.com/file-formats/pdf/working-with-digitalsignature">section.</a>
    </div>
}



@section Title{
                    <title>ASP.NET MVC PDF library - Digital Signature Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Digital Signature in ASP.NET MVC PDF Library</h1>
                }
<script>
    function appendHashToAction(form) {
        try {
            if (window && window.location && window.location.hash) {
                // Ensure we don't duplicate the hash
                var hash = window.location.hash;
                if (form.action.indexOf(hash) === -1) {
                    form.action = form.action + hash;
                }
            }
        }
        catch (e) {
            // swallow any errors to avoid blocking form submit
        }
        return true;
    }
</script>