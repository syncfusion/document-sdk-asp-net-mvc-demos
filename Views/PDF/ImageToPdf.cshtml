@section ControlsSection {
    <div class="control-section">        
        @{Html.BeginForm("imagetopdf", "pdf", FormMethod.Post, new { enctype = "multipart/form-data", id = "imagetoPDF", @onsubmit = "return appendHashToAction(this);" });
            {

                <div class="tablediv" style="font-size:14px">
                    Click the button to view a PDF document generated by Essential PDF. Please note
                    that Adobe Reader or its equivalent is required to view the resultant document.
                    <br />
                    <br />
                    <text>Select the image files to convert into PDF document</text>
                    <br />
                    <div>
                        <br />
                        <input type="button" class="e-btn" value="Choose Files" onclick="openImagePicker()" />
                        <span id="fileNameBoxImages"> No files chosen </span>
                        <input type="file" id="fileUploadImages" name="imageFile" multiple accept=".png,.jpeg,.gif,.tiff" style="display:block;visibility:hidden;width:0;height:0;" />
                    </div>
                    <br />
                    <div id="errorlabel" value="error">
                        <p style="color: #FF0000;">
                            @Html.Label("", (string)ViewData["lab"])
                        </p>
                    </div>
                </div>

                <div>
                    <table width="100%">
                        <tr>
                            <td align="left" width="30%" style="padding:10px 7px 5px 0px">
                                <text>Page Size &nbsp;:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</text>
                                @Html.EJS().DropDownList("pageSize").DataSource(new List<string>{ "Fit", "A4", "Letter" }).Index(0).Width("135px").Render()
                            </td>
                        </tr>
                        <tr>
                            <td align="left" width="30%" style="padding:10px 7px 5px 0px">
                                <text>Page Orientation &nbsp;:&nbsp;&nbsp;</text>
                                @Html.EJS().DropDownList("pageOrientation").DataSource(new List<string>{ "Default", "Portrait", "Landscape" }).Index(0).Width("135px").Render()
                            </td>
                        </tr>
                        <tr>
                            <td align="left" width="30%" style="padding:10px 7px 5px 0px">
                                <text>Page Margin &nbsp;:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</text>
                                @Html.EJS().DropDownList("margin").DataSource(new List<string>{ "No margin", "Small", "Large" }).Index(0).Width("135px").Render()
                            </td>
                        </tr>
                    </table>
                </div>

                <br />
                <div class="tablediv" style="font-size:14px">
                    <div class="rowdiv">
                        <div class="celldiv">
                            <div>
                                <input type="submit" class="e-btn" value="Convert to PDF" style="width: 150px; text-transform:capitalize" />
                            </div>
                        </div>
                    </div>

                </div>


                Html.EndForm();
            }
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            var fileInput = document.getElementById('fileUploadImages');
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    var box = document.getElementById('fileNameBoxImages');
                    if (this.files && this.files.length > 0) {
                        var names = Array.prototype.slice.call(this.files).map(function (f) { return f.name; });
                        box.textContent = names.join(', ');
                    } else {
                        box.textContent = ' No files chosen ';
                    }
                }, false);
            }
        })();

        function openImagePicker() {
            document.getElementById('fileUploadImages').click();
        }
    </script>
}

@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
        This sample demonstrates to converter various raster images (JPEG, PNG, TIFF, and GIF) to a PDF document.
    </div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the Image to PDF in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
    <div id="description" style="margin-top: 10px">
        It is also possible to add margins and customize the page size based on the images.
        More information about the images can be found in this documentation <a href="https://help.syncfusion.com/file-formats/pdf/working-with-images">section.</a>
    </div>
}
@section Title{
                    <title>ASP.NET MVC PDF library - Image to PDF Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Image to PDF in ASP.NET MVC PDF Library</h1>
                }
<script>
    function appendHashToAction(form) {
        try {
            if (window && window.location && window.location.hash) {
                // Ensure we don't duplicate the hash
                var hash = window.location.hash;
                if (form.action.indexOf(hash) === -1) {
                    form.action = form.action + hash;
                }
            }
        }
        catch (e) {
            // swallow any errors to avoid blocking form submit
        }
        return true;
    }
</script>