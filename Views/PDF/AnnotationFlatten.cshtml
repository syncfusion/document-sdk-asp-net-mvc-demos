@section ControlsSection
{
    <div class="control-section">
        <style>
            .control-section .checkbox-field {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                line-height: 1;
            }

            .control-section .checkbox-field input[type="checkbox"] {
                margin: 0;
                vertical-align: middle;
                width: 16px;
                height: 16px;
                box-sizing: border-box;
            }

            .control-section .checkbox-field label {
                margin: 0;
            }
        </style>
        @{Html.BeginForm("annotationflatten", "pdf", FormMethod.Post, new { enctype = "multipart/form-data" });
            {
                <div style="font-size:14px">
                    Click the button to view an PDF document generated by Essential PDF. Please note
                    that Adobe Reader or its equivalent is required to view the resultant document.

                </div>
                <div class="tablediv" style="font-size:14px">
                    <div class="rowdiv">
                        <div class="celldiv">
                            <table width="100%">
                                <tbody>
                                    <tr>
                                        <td align="left">
                                            <br />
                                            <span id="label8">Annotation Creation:</span>
                                            <div style="border: solid 1px #788DB3; line-height: 11px; padding: 10px; ">
                                                <table cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td class="checkbox-field">
                                                                @Html.EJS().CheckBox("checkboxFlatten").Name("checkboxFlatten").Value("Flatten").Checked(false).Label("Flatten annotation").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","checkboxFlatten"}}).Render()
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td align="left">
                                                                <br />
                                                                <input name="submit" class="e-btn" id="submit" type="submit" value="Create Annotations" style="width: 180px; " />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <br />
                <div class="rowdiv">
                    <div class="celldiv">
                        <table width="100%">
                            <tbody>
                                <tr>
                                    <td align="left">
                                        <br />
                                        <span id="label8">Annotation Flatten:</span>
                                        <div style="border: solid 1px #788DB3; line-height: 23px; padding: 10px; ">
                                            <table cellspacing="0" cellpadding="0" border="0">
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            <div style="font-size:14px">
                                                                <input type="button" class="e-btn" value="Choose File" onclick="openPageFlatten()">
                                                                <span id="fileNameBoxFlatten"> No file chosen </span>
                                                                <input type="file" name="file" id="fileUploadFlatten" accept="application/pdf" style="display:block;visibility:hidden;width:0;height:0;" />
                                                            </div>
                                                            <br />
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="left">
                                                            <input type="submit" class="e-btn" value="Flatten Annotations" style="width: 180px; text-transform:capitalize" id="flatternButton" disabled />
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <br />

                Html.EndForm();
            }}

    </div>
}
@section Scripts {
    <script>
        (function () {
            var fileInput = document.getElementById('fileUploadFlatten');
            var flattenButton = document.getElementById('flatternButton');
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    if (this.files && this.files.length > 0) {
                        flattenButton.disabled = false;
                        document.getElementById('fileNameBoxFlatten').textContent = this.files[0].name;
                    } else {
                        flattenButton.disabled = true;
                        document.getElementById('fileNameBoxFlatten').textContent = ' No file chosen ';
                    }
                }, false);
            }
        })();

        function openPageFlatten() {
            document.getElementById('fileUploadFlatten').click();
        }
    </script>
}
@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
        This sample demonstrates the creation of different types of annotations such as ink, free text, pop up, text markup annotation, and more. The Essential PDF supports  <a href="https://help.syncfusion.com/file-formats/pdf/working-with-annotations#supported-annotation-types">20+ annotations</a> with create, edit, and delete support.
    </div>
}
@section Meta{
    <meta name="description" content="This example demonstrates the Annotations in ASP.NET MVC PDF library. Explore here for more details." />
}
@section Description{
    <div id="description" style="margin-top: 10px">
        This feature can be used for reviewing purpose.
        More information about the annotations can be found in this documentation <a href="https://help.syncfusion.com/file-formats/pdf/working-with-annotations"> section. </a>
    </div>
}
@section Title{
    <title>ASP.NET MVC PDF library - Annotations Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of Annotations in ASP.NET MVC PDF Library</h1>
}