@using Syncfusion.EJ2
@using Syncfusion.EJ2.DropDowns
@using EJ2MVCSampleBrowser.Models

@{ViewData["Title"] = "    Essential PDF : Encryption : Syncfusion";}

@{Html.BeginForm("encryption", "pdf", FormMethod.Post); }

@section ControlsSection{
    <div class="control-section">
        <div class="tablediv" style="font-size:14px">
            Click the button below to view a PDF created with Essential PDF.
            Please note that Adobe Reader or its equivalent is required to view the resultant document. However, AES-GCM encryption is not supported by Adobe Reader to view such documents, use Foxit Reader or another compatible PDF viewer.
        </div>
        <br />
        <div class="tablediv" style="font-size:14px">
            <div class="rowdiv">
                <div style="padding: 5px 7px 5px 0px; font-size:14px">
                    <style>
                        .control-section .radio-row { display: flex; align-items: center; gap: 12px; }
                        .control-section .radio-group { display: inline-flex; align-items: center; gap: 16px; flex-wrap: wrap; }
                        .control-section .radio-field { display: inline-flex; align-items: center; gap: 8px; line-height: 1; }
                        .control-section .radio-field input[type="radio"]{ margin: 0; vertical-align: middle; }
                        .control-section .radio-field label{ margin: 0; }
                    </style>
                    <div>
                        <div class="radio-row">
                            <label style="font-weight:normal">Encryption Type&nbsp;:</label>
                            <div class="radio-group">
                                <span class="radio-field">
                                    @Html.EJS().RadioButton("encryptionType").Name("encryptionType").Value("40_RC4").Checked(false).Label("40 Bit RC4").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","rdButton40"},{"onchange","hideDropDownList()"}}).Render()
                                </span>
                                <span class="radio-field">
                                    @Html.EJS().RadioButton("encryptionType").Name("encryptionType").Value("128_RC4").Checked(false).Label("128 Bit RC4").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","rdButton128RC4"},{"onchange","hideDropDownList()"}}).Render()
                                </span>
                                <span class="radio-field">
                                    @Html.EJS().RadioButton("encryptionType").Name("encryptionType").Value("128_AES").Checked(true).Label("128 Bit AES").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","rdButton128AES"},{"onchange","hideDropDownList()"}}).Render()
                                </span>
                                <span class="radio-field">
                                    @Html.EJS().RadioButton("encryptionType").Name("encryptionType").Value("256_AES").Checked(false).Label("256 Bit AES").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","rdButton256"},{"onchange","hideDropDownList()"}}).Render()
                                </span>
                                <span class="radio-field">
                                    @Html.EJS().RadioButton("encryptionType").Name("encryptionType").Value("256_AES_Revision_6").Checked(false).Label("256 Bit AES Revision 6").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","rdButton256Revision6"},{"onchange","hideDropDownList()"}}).Render()
                                </span>
                                <span class="radio-field">
                                    @Html.EJS().RadioButton("encryptionType").Name("encryptionType").Value("256_AES_GCM").Checked(false).Label("256 Bit AES GCM").HtmlAttributes(new System.Collections.Generic.Dictionary<string, object>{{"id","rdButton256AESGCM"},{"onchange","hideDropDownList()"}}).Render()
                                </span>
                            </div>
                        </div>
                        <div style="margin-top: 10px">
                            <div style="width:60%" id="dropDownBox">
                                <label style="font-weight:bold">
                                    Encryption Options&nbsp;&nbsp;&nbsp;
                                </label>
                                @{
                                    var encryptData = ViewData["data"];
                                    IEnumerable<string> encryptItems;

                                    if (encryptData != null && encryptData is string[])
                                    {
                                        encryptItems = (string[])encryptData;
                                    }
                                    else
                                    {
                                        encryptItems = new List<string>();
                                    }
                                }

                                @Html.EJS().DropDownList("encryptOptionType").DataSource(encryptItems).PopupHeight("220px").Index(0).Width("280px").HtmlAttributes(new Dictionary<string, object> { { "id", "encryptOptionType" } }).Render()
                            </div>
                            <div>
                                <br>
                                <label style="font-weight:normal">
                                    User Password&nbsp;&nbsp;&nbsp;&nbsp;:
                                </label>


                                <label style="font-weight: normal">
                                    password
                                </label>

                                <label style="font-weight: normal">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>


                                <label style="font-weight: normal" for="rdButton128AES">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>

                                <label for="rdButton256" style="font-weight: normal">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>

                                <label for="rdButton256" style="font-weight: normal">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>
                            </div>
                            <div>

                                <label style="font-weight:normal">
                                    Owner Password&nbsp;:
                                </label>

                                <label style="font-weight: normal">
                                    syncfusion
                                </label>


                                <label style="font-weight: normal">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>


                                <label style="font-weight: normal" for="rdButton128AES">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>


                                <label for="rdButton256" style="font-weight: normal">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>

                                <label for="rdButton256" style="font-weight: normal">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </label>
                            </div>
                        </div>
                    </div>
                   
                </div>
            </div>
        </div>
        <br />
        <div class="tablediv" style="font-size:14px">
            <div class="rowdiv">
                <div class="celldiv">
                    <div>
                        <input type="submit" class="e-btn" value="Encrypt PDF" style="width: 150px; text-transform:capitalize" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section ActionDescription{
    <p>
        This sample demonstrates how to encrypt the PDF document with encryption standards like 40-bit RC4, 128-bit RC4, 128-bit AES, 256-bit AES, advanced encryption standard 256-bit AES Revision 6 (PDF 2.0) and 256-bit AES-GCM (PDF 2.0) to protect documents against unauthorized access.
    </p>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the Encryption in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
    <p>
        It is possible to protect with user password or owner password or both passwords and also possible to change or remove password and permission.
        More information about encryption or decryption can be found in this documentation <a href="https://help.syncfusion.com/file-formats/pdf/working-with-security">section.</a>
    </p>
}
    <script type="text/javascript">
        function hideDropDownList() {
            var radioButtons = document.getElementsByName('encryptionType');
            for (var x = 0; x < radioButtons.length; x++) {
                if (radioButtons[x].checked) {
                    switch (radioButtons[x].value) {
                        case "40_RC4":
                        case "128_RC4":
                            var dropDown = document.getElementById('encryptOptionType');
                            if (dropDown) {
                                dropDown.value = "Encrypt all contents";
                            }
                            document.getElementById('dropDownBox').style.display = 'none';
                            break;
                        case "128_AES":
                        case "256_AES":
                        case "256_AES_Revision_6":
                        case "256_AES_GCM":
                            document.getElementById('dropDownBox').style.display = 'block';
                            break;
                    }
                }
            }
        }
    </script>
@section Title{
                    <title>ASP.NET MVC PDF library - Encryption Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Encryption in ASP.NET MVC PDF Library</h1>
                }