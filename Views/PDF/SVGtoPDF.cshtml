@section ControlsSection{
    <div class="control-section">
        <form method="post" enctype="multipart/form-data" id="svgtopdf" onsubmit="return appendHashToAction(this);">
            <div class="tablediv" style="font-size:14px">
                <div class="rowdiv">
                    <text>
                        Click the button to view a PDF document generated by Essential PDF. Please note that Adobe Reader or its equivalent is required to view the resultant document.
                    </text>
                    <br />
                    <br />
                    <text>Choose an SVG file to convert.</text>
                    <br />
                    <br />
                    <input type="button" class="e-btn" value="Choose File" onclick="openPageSvgPdf()">
                    <span id="fileNameBoxSvgPdf"> SVGtoPDF.svg </span>
                    <input type="file" id="fileUploadSvgPdf" name="uploadedFile" accept=".svg" style="display:block;visibility:hidden;width:0;height:0;" /> <br />
                </div>
                <div class="rowdiv">
                    <div class="celldiv">
                        <input class="e-btn" type="submit" value="Convert to PDF" name="createPDF" style="width:150px; text-transform:capitalize" />
                    </div>
                    <br />
                </div>
                @Html.Label("", (string)ViewData["lab"], new { style = "color:red" })
            </div>
        </form>
        <br />
    </div>
    <script>
        function openPageSvgPdf() {
            document.getElementById('fileUploadSvgPdf').click();
            document.getElementById('fileUploadSvgPdf').addEventListener('change', readFileSvgPdf, false);
        }

        function readFileSvgPdf(evt) {
            var uploadedFiles = evt.target.files;
            var maxFileSize = 10 * 1024 * 1024; // 10 MB

            if (uploadedFiles && uploadedFiles.length > 0) {
                if (uploadedFiles[0].size > maxFileSize) {
                    alert('The uploaded file is too large. Maximum allowed file size is 10 MB.');
                    evt.target.value = '';
                    document.getElementById('fileNameBoxSvgPdf').textContent = ' SVGtoPDF.svg ';
                    return;
                }
                document.getElementById('fileNameBoxSvgPdf').textContent = uploadedFiles[0].name;
            }
        }
    </script>
}

@section Scripts {
    <script>
        (function () {
            var fileInput = document.getElementById('fileUploadSvg');
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    if (this.files && this.files.length > 0) {
                        document.getElementById('fileNameBoxSvg').textContent = this.files[0].name;
                    } else {
                        document.getElementById('fileNameBoxSvg').textContent = ' No file chosen ';
                    }
                }, false);
            }
        })();

        function openSvgPicker() {
            document.getElementById('fileUploadSvg').click();
        }
    </script>
}
@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
        This sample demonstrates how to convert an SVG file to a PDF document using Essential PDF.
    </div>
}
@section Meta{
    <meta name="description" content="This example demonstrates the SVG to PDF in ASP.NET MVC PDF library. Explore here for more details." />
}
@section Description{
    <div id="description" style="margin-top: 10px">
        More information about SVG to PDF document can be found in this documentation <a href="https://help.syncfusion.com/document-processing/pdf/pdf-library/net/working-with-document-conversions#svg-to-pdf">section</a>.
    </div>
}
@section Title{
    <title>ASP.NET MVC PDF library - SVG to PDF Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of SVG to PDF in ASP.NET MVC PDF Library</h1>
}