@section ControlsSection{
    <div class="control-section">
        @{Html.BeginForm("linearizedpdf", "pdf", FormMethod.Post, new { enctype = "multipart/form-data" });
            {
                <div class="tablediv" style="font-size:14px">
                   <div class="rowdiv">
                        <div class="celldiv">
                                <table width="100%">
                                    <tr>
                                                <td>
                                                    Click the button to view a PDF document generated by Essential PDF. Please note that Adobe Reader or its equivalent is required to view the resultant document.
                                                    <br /><br />
                                                    Choose a PDF file for linearization
                                                </td>
                                                
                                    </tr>
                                    <tr>
                                        <td align="left">
                                            <br />
                                            <input type="button" class="e-btn" value="Choose PDF file" onclick="openLinearizedPdfFile()" />
                                            <span id="linearizedPdfFileName">HTTP Succinctly.pdf</span>
                                            <input type="file" id="linearizedPdfFile" name="file" accept="application/pdf" style="display:block;visibility:hidden;width:0;height:0;" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left">
                                            <br />
                                            <input type="submit" class="e-btn" value="Convert to Linearized PDF" style="width:225px; text-transform:capitalize" />
                                        </td>
                                    </tr>
                                </table>
                        </div>
                    </div>
                </div>
                <br />
                @Html.Label("", (string)ViewData["lab"], new { style = "color:red" })
                Html.EndForm();
            }
          }
</div>
}
<script>
    function openLinearizedPdfFile() {
        var fileInput = document.getElementById('linearizedPdfFile');
        fileInput.click();
        fileInput.addEventListener('change', function () {
            var uploadedFiles = fileInput.files;
            var maxFileSize = 10 * 1024 * 1024; // 10 MB

            if (uploadedFiles && uploadedFiles.length > 0) {
                if (uploadedFiles[0].size > maxFileSize) {
                    alert('The uploaded PDF file is too large. Maximum allowed file size is 10 MB.');
                    fileInput.value = '';
                    document.getElementById('linearizedPdfFileName').textContent = 'HTTP Succinctly.pdf';
                    return;
                }
                document.getElementById('linearizedPdfFileName').textContent = uploadedFiles[0].name;
            }
        }, { once: true });
    }
</script>
@section ActionDescription{
    <div id="action-description" style="margin-top: 10px">
        This sample demonstrates how to convert an existing PDF document into a linearized PDF for faster web viewing.
    </div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates the linearized PDF in ASP.NET MVC PDF library. Explore here for more details."/>
                }
@section Description{
    <div id="description" style="margin-top: 10px">
        More information about linearized PDF can be found in this documentation <a href="https://help.syncfusion.com/document-processing/pdf/pdf-library/net/working-with-document#linearizing-a-pdf-document">section</a>.
    </div>
}
@section Title{
                    <title>ASP.NET MVC PDF library - Linearized PDF Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Linearized PDF in ASP.NET MVC PDF Library</h1>
                }
