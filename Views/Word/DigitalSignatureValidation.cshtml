@model EJ2MVCSampleBrowser.Models.SignatureValidationMesssage

@{
    bool isErrorMessage =
        Model.Message == "Browse a DOCX document and then click the button to validate digital signature" ||
        Model.Message == "Please choose DOCX document to validate digital signature";

    string textColor = isErrorMessage ? "color:red;" : "";
}

@section ControlsSection
{
    <div class="control-section">
        @{
            Html.BeginForm(
                "digitalsignaturevalidation",
                "word",
                FormMethod.Post,
                new
                {
                    id = "sigForm",
                    @onsubmit = "return appendHashToAction(this);",
                    enctype = "multipart/form-data"
                });

            {
                <div class="tablediv" style="font-size:14px">
                    <text class="rowdiv">
                        Click the button to validate the digital signature using .NET Word (DocIO) Library.
                    </text>
                </div>

                <div class="tablediv" style="font-size:14px; margin-top:10px;">
                    <div class="rowdiv">
                        <div class="celldiv">

                            <label style="font-weight:normal">
                                Select Document:
                            </label>

                            @Html.TextBox(
                                "file",
                                "",
                                new
                                {
                                    type = "file",
                                    accept = ".docx",
                                    style = "margin-left:5px;"
                                })

                        </div>
                    </div>
                </div>

                <div class="tablediv" style="font-size:14px">
                    <div class="rowdiv">
                        <div class="celldiv">

                            <table style="width:100%">
                                <tr>
                                    <td align="left">
                                        <br />

                                        <input type="submit"
                                               class="e-btn"
                                               value="Validate Signature"
                                               name="SignatureValidation"
                                               style="width:170px; text-transform:capitalize" />
                                    </td>
                                </tr>
                            </table>

                        </div>
                    </div>
                </div>

                Html.EndForm();
            }
        }

        <br />

        @Html.TextAreaFor(
            s => s.Message,
            1,
            1,
            new
            {
                @class = "e-input",
                @style = "width:850px; height:225px; " + textColor,
                @readonly = "readonly"
            })

    </div>
}

@section ActionDescription
{
    <div id="action-description" style="margin-top:10px">
        This sample demonstrates how to validate the digital signatures in an existing Word document using the .NET Word Library (DocIO).
    </div>
}

@section Description
{
    <div>
        With the digital signature support, you can validate the authenticity
        and ensure the security of your documents very easily and fast.

        <ul>
            <li>
                You can open digitally signed Word documents and allow DocIO
                to verify the validity of the signatures, checking if they are
                trusted or have been tampered with.
            </li>

            <li>
                You can ensure strict document processing security by
                programmatically checking the signature authenticity,
                author identity, and structural document integrity.
            </li>
        </ul>
    </div>

    <div style="margin-top:15px">
        More information about the Digital Signature validation can be found in this
        <a href="https://help.syncfusion.com/document-processing/word/word-library/net/working-with-digital-signature"
           aria-label="Documentation">
            Documentation
        </a>
        section.
    </div>
}

