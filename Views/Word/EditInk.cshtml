@using Syncfusion.EJ2
@{ViewData["Title"] = "    Essential DocIO (Word) : Edit Ink : Syncfusion";}
@section ControlsSection{
    <div class="control-section">
        @{Html.BeginForm("EditInk", "Word", FormMethod.Post);
            {
                <div style="margin-top: 10px">
                    Click the button to view the generated Word document or PDF. Please note that Microsoft Word Viewer or Microsoft Word is required to view the resultant Word document and PDF viewer is required to view the resultant PDF.
                    <div style="margin-top: 10px">
                        Save As :
                        <input type="radio" id="rdButtonDocx" name="Group1" value="WordDocx" style="margin-left: 7px" checked="checked" />
                        <label for="rdButtonDocx" style="font-size:13px;font-weight:normal;text-align:match-parent" data-toggle="tooltip" title="Saves the resultant document as Word Docx format">DOCX</label>
                        &nbsp;
                        <input type="radio" id="rdButtonPdf" name="Group1" value="Pdf" style="margin-left: 7px" />
                        <label for="rdButtonPdf" style="font-size:13px;font-weight:normal;text-align:match-parent" data-toggle="tooltip" title="Saves the resultant document as PDF">PDF</label>
                    </div>
                    <div style="margin-top: 8px">
	                    <input id="viewtemplate" name="Button" class="e-btn" type="submit" value="View Template" style="width:150px;text-transform:capitalize" />
                        &nbsp;
                        <input class="e-btn" name="Button" type="submit" value="Generate Document" style="width:170px;text-transform:capitalize" />
                    </div>
                </div>
                Html.EndForm();
            }
        }
    </div>
}
@section ActionDescription{
    <div>
        This sample demonstrates how to modify Ink in a Word document using the .NET Word Library (DocIO).
    </div>
}
@section Description{
    <div>
       The .NET Word Library (DocIO) provides flexibility to fully customize ink elements within Word documents.
        <ul>
            <li>
                You can modify the path points of an ink stroke to adjust its shape or flow.
            </li>
            <li>
                You can customize ink appearance properties, including effects, color, thickness, and more.
            </li>
        </ul>
    </div>
    <div style="margin-top: 15px">
        More information about Ink can be found in this 
        <a href="https://help.syncfusion.com/document-processing/word/word-library/net/working-with-ink">documentation</a>
        section.
    </div>
}
@section Meta{
                    <meta name="description" content="This example demonstrates how to Edit Ink in ASP.NET MVC Word (DocIO) library. Explore here for more details."/>
                }
@section Title{
                    <title>ASP.NET MVC Word (DocIO) library - Edit Ink Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Edit Ink in ASP.NET MVC Word (DocIO) Library</h1>
                }