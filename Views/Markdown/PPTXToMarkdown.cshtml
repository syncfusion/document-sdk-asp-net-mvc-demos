@using Syncfusion.EJ2
@{
    ViewData["Title"] = "    Essential Markdown : Export, Presentation to Markdown, Conversion : Syncfusion";
}
@section ControlsSection{
    <div class="control-section">
        @{Html.BeginForm("PPTXToMarkdown", "Markdown", FormMethod.Post, new { enctype = "multipart/form-data" });
            {
                <div style="margin-top: 10px">
                    Select Document
                    <br />
                    <input type="file" name="file" id="fileUpload" accept=".pptx" style="display:block;visibility:hidden;width:0;height:0;" />
                    <input type="button" name="uploadButton" value="Choose File" onclick="openFile()" />
                    <input type="text" id="fileName" value="PPTX_To_Markdown.pptx" style="border:none;" readonly="readonly"/>
                    <div style="margin-top: 8px">
                        Click the button to view the Markdown document generated using the .NET PowerPoint (Presentation) and .NET Markdown libraries. Please note that a text editor or Markdown Viewer is required to view the Markdown document.
                        <div style="margin-top: 8px">
                            <input class="e-btn" type="submit" value="Convert to Markdown" name="button" style="width: 170px; text-transform:capitalize" />
                        </div>
                    </div>
                </div>
                <br />
                <div class="text-danger">
                    @ViewData["Message"]
                </div>
                Html.EndForm();
            }
        }
    </div>
}
@section ActionDescription{
    <div>
        This sample demonstrates how to convert the PowerPoint presentation to Markdown using .NET PowerPoint (Presentation) and .NET Markdown libraries.
    </div>
}
@section Description{
    <div>
        The .NET PowerPoint (Presentation) library provides support to convert PowerPoint presentations to Markdown.
        <ul>
            <li>
                You can convert existing PPTX documents or those created using the .NET PowerPoint (Presentation) library to Markdown.
            </li>
            <li>
                You can convert text, tables, hyperlinks, list, and images from PPTX documents to Markdown.
            </li>
            <li>
                You can customize the image path while exporting to Markdown.
            </li>
        </ul>
    </div>
    <div style="margin-top: 15px">
        More information about PowerPoint to Markdown conversion can be found in this
        <a href="https://help.syncfusion.com/document-processing/powerpoint/conversions/powerpoint-to-markdown">documentation</a>
        section.
    </div>
    <script>
         function openFile() {
             document.getElementById('fileUpload').click();
             document.getElementById('fileUpload').addEventListener('change', updateFileName, false);
        }
        function updateFileName(evt) {
            var upoadedFiles = evt.target.files;
            filename = upoadedFiles[0].name;
            document.getElementById('fileName').value = filename;
        }
    </script>
}
@section Meta{
    <meta name="description" content="This example demonstrates the PowerPoint to Markdown conversion in ASP.NET MVC Markdown library. Explore here for more details." />
}
@section Title{
    <title>ASP.NET MVC Markdown library - Presentation to Markdown Example - Syncfusion Demos</title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of PowerPoint to Markdown in ASP.NET MVC Markdown Library</h1>
}