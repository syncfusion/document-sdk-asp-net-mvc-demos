@using Syncfusion.EJ2
@{
    ViewData["Title"] = "    Essential Presentation (PowerPoint) : Import, Markdown To Presentation, Conversion : Syncfusion";
}

@section ControlsSection{
    <div class="control-section">
        @{Html.BeginForm("MarkdownToPPTX", "PowerPoint", FormMethod.Post, new { enctype = "multipart/form-data" });
            {
                <div style="margin-top: 10px">
                    Select Document
                    <br />
                    <input type="file" name="file" id="fileUpload" accept=".md" style="display:block;visibility:hidden;width:0;height:0;" />
                    <input type="button" name="uploadButton" value="Choose File" onclick="openFile()" />
                    <input type="text" id="fileName" value="Markdown_To_PPTX.md" style="border:none;" readonly="readonly"/>
                    <div style="margin-top: 8px">
                        Click the button to view the generated PowerPoint presentation generated by .NET PowerPoint (Presentation) library. Please note that Markdown viewer or its equivalent is required to view the resultant document.
                        <div style="margin-top: 8px">
                            <input class="e-btn" type="submit" value="Convert to PPTX" name="button" style="width: 170px; text-transform:capitalize" />
                        </div>
                    </div>
                </div>
                <br />
                <div class="text-danger">
                    @ViewData["Message"]
                </div>
                Html.EndForm();
            }
        }
    </div>
    <script>
         function openFile() {
             document.getElementById('fileUpload').click();
             document.getElementById('fileUpload').addEventListener('change', updateFileName, false);
        }
        function updateFileName(evt) {
            var upoadedFiles = evt.target.files;
            filename = upoadedFiles[0].name;
            document.getElementById('fileName').value = filename;
        }
    </script>
}
@section ActionDescription{
    <div>
        This sample demonstrates how to convert the Markdown file to PowerPoint presentation using .NET PowerPoint (Presentation) library.
    </div>
}
@section Description{
    <div>
        .NET PowerPoint (Presentation) library provides support to convert Markdown file to PPTX file.
        <ul>
            <li>
                You can convert text, tables, hyperlinks, numbered and bulleted list, and images from Markdown to PPXT format.
            </li>
			<li> You can customize the image while importing Markdown file.</li>
        </ul>
    </div>
    <div style="margin-top: 15px">
        More information about Markdown to PowerPoint conversion can be found in this 
        <a href="https://help.syncfusion.com/document-processing/powerpoint/conversions/markdown-to-powerpoint">documentation</a>
        section.
    </div>
}
@section Meta{
    <meta name="description" content="This example demonstrates the Markdown to PowerPoint conversion in ASP.NET MVC PowerPoint (Presentation) library. Explore here for more details." />
}
@section Title{
    <title>ASP.NET MVC PowerPoint (Presentation) library - Markdown to Presentation Example - Syncfusion Demos</title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of Markdown to PowerPoint in ASP.NET MVC PowerPoint (Presentation) Library</h1>
}