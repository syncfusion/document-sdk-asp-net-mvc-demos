@using Syncfusion.EJ2;

@section ActionDescription{
    This sample demonstrates the conversion of Excel documents to Markdown file using Essential XlsIO.
}
@section Meta{
                    <meta name="description" content="This example demonstrates the Excel To Markdown in ASP.NET MVC Excel (XlsIO) library. Explore here for more details."/>
                }
@section Description{
    <p>
        Essential XlsIO supports to convert Excel data to Markdown files by simply saving the workbook.
    </p>
    <br />
    <b>Features:</b>
    <br />
    <br />
    <ul>
        <li>Export Excel files as Markdown documents with ease.</li>
        <li>Preserve text, numbers, date/time values, and formulas during conversion.</li>
        <li>Convert charts into images and retain embedded pictures in the Markdown file.
    </ul>
}

@section ControlsSection{
    <div class="control-section">
        @{Html.BeginForm("ExcelToMarkdown", "Excel", FormMethod.Post);
            {
                <div class="Common">
                    <div class="tablediv">
                        <div class="rowdiv">
                            <p style="font-weight:normal">
                                Click the "Input Template" button to view the input Excel document. Please note that the Microsoft Excel viewer or Microsoft Excel is required to view the Excel document.
                            </p>
                            <p style="font-weight:normal">
                                Click the "Convert to Markdown" button to view the converted Markdown file.
                            </p>
                        </div>
                        <br />
                        <div class="rowdiv">
                            <div class="celldiv">
                                <input id="inputTemplate" class="e-btn" type="submit" name="button" value="Input Template" style="width:150px;" />
                                &nbsp;&nbsp;&nbsp;
                                <input id="convertToMarkdown" class="e-btn" type="submit" name="button" value="Convert to Markdown" style="width:160px;" />
                            </div>
                        </div>
                    </div>
                </div>
                Html.EndForm();
            }
        }
    </div>
}

@section Title{
                    <title>ASP.NET MVC Excel (XlsIO) library - Excel To Markdown Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Excel To Markdown in ASP.NET MVC Excel (XlsIO) Library</h1>
                }